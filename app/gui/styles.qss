/* ==========================================================================
   ПРОМЫШЛЕННАЯ ТЕМА HIGH-PERFORMANCE HMI: «ИНДУСТРИАЛЬНЫЙ DARK / SLATE»
   Файл: app/gui/styles.qss (Оптимизированная геометрия шрифтов)
   ========================================================================== */

/* 1. БАЗОВАЯ ТИПОГРАФИКА И ФОН */
QWidget {
    background-color: #1E222B;
    color: #DCE2E6;
    font-family: "Segoe UI", "Roboto", "Ubuntu", sans-serif;
    font-size: 9.5pt;
    selection-background-color: #2B5278;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #181B22;
}

/* 2. ПАНЕЛИ ГРУППИРОВКИ */
QGroupBox {
    font-size: 9.5pt;
    font-weight: bold;
    color: #8A99AD;
    border: 1px solid #2D333F;
    border-radius: 4px;
    margin-top: 18px;
    padding: 8px;
    background-color: #212631;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 4px;
    padding: 0 4px;
    background-color: #212631;
    color: #A0B0C0;
}

/* 3. ВКЛАДКИ (QTabWidget и QTabBar) */
QTabWidget::pane {
    border: 1px solid #2D333F;
    background-color: #1E222B;
    top: -1px;
}

QTabBar {
    background-color: #181B22;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #181B22;
    color: #8A99AD;
    font-weight: bold;
    font-size: 8.5pt;
    padding: 5px 12px;
    border: 1px solid #262B36;
    border-bottom: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #282E3A;
    color: #BAC7D5;
}

QTabBar::tab:selected {
    background-color: #212631;
    color: #FFFFFF;
    border-top: 2px solid #3A6D9E;
    border-left: 1px solid #2D333F;
    border-right: 1px solid #2D333F;
    border-bottom: 1px solid #212631;
}

/* Кнопки прокрутки вкладок (стрелки) */
QTabBar QToolButton {
    background-color: #212631;
    border: 1px solid #2D333F;
    border-radius: 2px;
    color: #8A99AD;
}
QTabBar QToolButton:hover {
    background-color: #282E3A;
    color: #FFFFFF;
}

/* 4. КНОПКИ */
QPushButton {
    background-color: #333A48;
    color: #E0E6ED;
    border: 1px solid #3F4756;
    border-radius: 3px;
    padding: 4px 10px;
    font-weight: bold;
    font-size: 9pt;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #3F4756;
    border-color: #4F586B;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #282E3A;
    border-color: #333A48;
}

QPushButton:disabled {
    background-color: #1E222B;
    color: #555E6D;
    border-color: #262B36;
}

/* Служебные типы кнопок */
QPushButton#btn_run, QPushButton#btn_save {
    background-color: #1E5E3A;
    border-color: #267347;
    color: #FFFFFF;
}
QPushButton#btn_run:hover, QPushButton#btn_save:hover {
    background-color: #267347;
}

QPushButton#btn_stop, QPushButton#btn_delete {
    background-color: #7A2828;
    border-color: #8F3030;
    color: #FFFFFF;
}
QPushButton#btn_stop:hover, QPushButton#btn_delete:hover {
    background-color: #8F3030;
}

QPushButton#btn_new_batch, QPushButton#btn_import, QPushButton#btn_export, QPushButton#btn_search {
    background-color: #284461;
    border-color: #33567B;
    color: #FFFFFF;
}
QPushButton#btn_new_batch:hover, QPushButton#btn_import:hover, QPushButton#btn_export:hover, QPushButton#btn_search:hover {
    background-color: #33567B;
}

QPushButton#btn_toggle_ai {
    background-color: #2D3848;
    border-color: #3B4A5E;
    color: #DCE2E6;
}
QPushButton#btn_toggle_ai:checked {
    background-color: #3B4A5E;
    border: 1px solid #5C82A6;
    color: #FFFFFF;
}

/* 5. ПОЛЯ ВВОДА И ВЫБОРА */
QLineEdit, QComboBox {
    background-color: #181B22;
    color: #E0E6ED;
    border: 1px solid #2D333F;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 9.5pt;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3A6D9E;
    background-color: #15181F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #2D333F;
    background-color: #212631;
}

QComboBox QAbstractItemView {
    background-color: #181B22;
    color: #E0E6ED;
    border: 1px solid #2D333F;
    selection-background-color: #2B5278;
    selection-color: #FFFFFF;
}

/* 6. ТАБЛИЦЫ */
QTableWidget {
    background-color: #181B22;
    color: #DCE2E6;
    gridline-color: #262B36;
    border: 1px solid #2D333F;
    border-radius: 2px;
    font-family: "Consolas", monospace;
    font-size: 9pt;
}

QHeaderView::section {
    background-color: #212631;
    color: #8A99AD;
    padding: 4px;
    border: none;
    border-right: 1px solid #2D333F;
    border-bottom: 1px solid #2D333F;
    font-family: "Segoe UI", sans-serif;
    font-weight: bold;
    font-size: 8.5pt;
}

/* 7. КАРТОЧКИ ПАРАМЕТРОВ */
QFrame#param_card {
    background-color: #181B22;
    border: 1px solid #2D333F;
    border-radius: 4px;
}

QLabel#lbl_card_title {
    color: #8A99AD;
    font-weight: bold;
    font-size: 8.5pt;
    background-color: transparent;
}

QLabel#lbl_card_value {
    color: #F0F4F8;
    font-family: "Consolas", monospace;
    font-size: 15pt;
    font-weight: bold;
    background-color: transparent;
}

QLabel#lbl_process_time {
    background-color: #181B22;
    color: #48BB78;
    border: 1px solid #243E30;
    border-radius: 4px;
    font-family: "Consolas", monospace;
    font-size: 24pt;
    font-weight: bold;
}

QLabel#val_extraction {
    background-color: #181B22;
    color: #7EA6CD;
    border: 1px solid #2D333F;
    border-radius: 3px;
    font-weight: bold;
    font-size: 9.5pt;
    padding: 5px;
}

/* 8. СКРОЛЛ-БАРЫ */
QScrollBar:vertical {
    border: none;
    background: #181B22;
    width: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333A48;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #475163;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #181B22;
    height: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #333A48;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar:horizontal:hover {
    background: #475163;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}